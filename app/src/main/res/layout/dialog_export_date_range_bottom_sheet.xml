<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="20dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/export_date_range_title"
        android:textAppearance="@style/Finan.Text.Title" />

    <!-- Preview tanggal range yang dipilih -->
    <TextView
        android:id="@+id/export_date_range_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textSize="14sp"
        android:textColor="@color/finan_text_secondary"
        android:fontFamily="sans-serif-medium" />

    <!-- Calendar range picker -->
    <com.dwlhm.finan.ui.common.CustomDatePickerView
        android:id="@+id/export_date_picker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <!-- Reset ke semua waktu -->
    <TextView
        android:id="@+id/export_date_reset"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground"
        android:padding="4dp"
        android:text="@string/export_date_reset"
        android:textColor="@color/finan_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <com.dwlhm.finan.ui.common.DialogActionsView
        android:id="@+id/export_date_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:primaryText="@string/export_date_apply"
        app:secondaryText="@string/export_date_cancel" />

</LinearLayout>
