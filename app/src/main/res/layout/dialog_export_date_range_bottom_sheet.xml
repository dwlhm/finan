<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="20dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/export_date_range_title"
        android:textAppearance="@style/Finan.Text.Title" />

    <TextView
        style="@style/Finan.Text.SectionLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/export_date_start" />

    <TextView
        android:id="@+id/export_date_start_value"
        style="@style/Finan.Control.OccurredAtValue"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:drawableStart="@drawable/ic_schedule" />

    <TextView
        style="@style/Finan.Text.SectionLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/export_date_end" />

    <TextView
        android:id="@+id/export_date_end_value"
        style="@style/Finan.Control.OccurredAtValue"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:drawableStart="@drawable/ic_schedule" />

    <TextView
        android:id="@+id/export_date_reset"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:padding="4dp"
        android:text="@string/export_date_reset"
        android:textColor="@color/finan_primary"
        android:textSize="14sp" />

    <com.dwlhm.finan.ui.common.DialogActionsView
        android:id="@+id/export_date_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:primaryText="@string/export_date_apply"
        app:secondaryText="@string/export_date_cancel" />
</LinearLayout>
