<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="com.google.android.material.card.MaterialCardView">

    <!-- Layer 1: Backdrop Glass Layer (Receives Blur Effect on API 31+) -->
    <View
        android:id="@+id/nav_glass_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Layer 2: Foreground Crisp Items Layer (Never Blurred) -->
    <LinearLayout
        android:id="@+id/nav_items_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <!-- Item 1: Catat -->
        <LinearLayout
            android:id="@+id/nav_item_capture"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="@drawable/bg_nav_item_ripple"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:id="@+id/nav_icon_capture"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/nav_capture"
                android:src="@drawable/ic_nav_capture"
                app:tint="@color/finan_primary" />

            <TextView
                android:id="@+id/nav_label_capture"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/nav_capture"
                android:textColor="@color/finan_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Item 2: Buku Kas -->
        <LinearLayout
            android:id="@+id/nav_item_dashboard"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="@drawable/bg_nav_item_ripple"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:id="@+id/nav_icon_dashboard"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/nav_dashboard"
                android:src="@drawable/ic_nav_history"
                app:tint="@color/finan_text_secondary" />

            <TextView
                android:id="@+id/nav_label_dashboard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/nav_dashboard"
                android:textColor="@color/finan_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Item 3: Pengaturan -->
        <LinearLayout
            android:id="@+id/nav_item_settings"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="@drawable/bg_nav_item_ripple"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:id="@+id/nav_icon_settings"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/nav_settings"
                android:src="@drawable/ic_nav_settings"
                app:tint="@color/finan_text_secondary" />

            <TextView
                android:id="@+id/nav_label_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/nav_settings"
                android:textColor="@color/finan_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>
</merge>
