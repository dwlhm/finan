<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <!-- Bottom Sheet Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Title -->
            <TextView
                android:id="@+id/category_editor_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/Finan.Text.Title"
                android:textColor="@color/finan_text_primary" />

            <TextView
                android:id="@+id/category_editor_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Atur ikon, nama, tipe, dan klasifikasi arus kas"
                android:textAppearance="@style/Finan.Text.Body"
                android:textColor="@color/finan_text_secondary"
                android:textSize="13sp" />

            <!-- Icon & Name Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Interactive Emoji Icon Avatar Container -->
                <FrameLayout
                    android:id="@+id/category_icon_container"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_icon_avatar"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">

                    <TextView
                        android:id="@+id/category_icon_preview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="🍔"
                        android:textSize="32sp" />

                    <!-- Edit Badge -->
                    <TextView
                        android:id="@+id/category_icon_edit_badge"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="bottom|end"
                        android:layout_marginEnd="2dp"
                        android:layout_marginBottom="2dp"
                        android:background="@drawable/bg_chip_selected"
                        android:gravity="center"
                        android:text="✏️"
                        android:textSize="10sp" />
                </FrameLayout>

                <!-- Category Name Field -->
                <com.dwlhm.finan.ui.common.LabeledEditTextView
                    android:id="@+id/category_name_field"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:inputType="textCapWords"
                    app:fieldHint="@string/category_name_example"
                    app:labelText="@string/category_name_label" />

                <!-- Legacy/Hidden Icon Input Field for compatibility -->
                <com.dwlhm.finan.ui.common.LabeledEditTextView
                    android:id="@+id/category_icon_field"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Category Type Section ("Dipakai Untuk") -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/category_type_label"
                android:textAppearance="@style/Finan.Text.SectionLabel"
                android:textColor="@color/finan_primary"
                android:textStyle="bold" />

            <!-- Visual Type Cards Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <!-- Expense Selector Card -->
                <LinearLayout
                    android:id="@+id/category_type_expense_card"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_category_type_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:id="@+id/category_type_expense_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💸 "
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/category_type_expense_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/category_type_expense"
                        android:textColor="@color/finan_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Income Selector Card -->
                <LinearLayout
                    android:id="@+id/category_type_income_card"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_category_type_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:id="@+id/category_type_income_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💰 "
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/category_type_income_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/category_type_income"
                        android:textColor="@color/finan_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Hidden CheckBoxes for code backing & error reporting -->
            <LinearLayout
                android:id="@+id/category_type_group"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <CheckBox
                    android:id="@+id/category_type_expense"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />

                <CheckBox
                    android:id="@+id/category_type_income"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Cash Flow Activity Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/category_activity_label"
                android:textAppearance="@style/Finan.Text.SectionLabel"
                android:textColor="@color/finan_primary"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/category_activity_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_control_surface"
                android:orientation="vertical"
                android:padding="8dp">

                <RadioButton
                    android:id="@+id/category_activity_operating"
                    style="@style/Finan.Control.RadioButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/finan_primary"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="@string/category_activity_operating"
                    android:textColor="@color/finan_text_primary" />

                <RadioButton
                    android:id="@+id/category_activity_investing"
                    style="@style/Finan.Control.RadioButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/finan_primary"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="@string/category_activity_investing"
                    android:textColor="@color/finan_text_primary" />

                <RadioButton
                    android:id="@+id/category_activity_financing"
                    style="@style/Finan.Control.RadioButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/finan_primary"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="@string/category_activity_financing"
                    android:textColor="@color/finan_text_primary" />

                <RadioButton
                    android:id="@+id/category_activity_unclassified"
                    style="@style/Finan.Control.RadioButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/finan_primary"
                    android:checked="true"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="@string/category_activity_unclassified"
                    android:textColor="@color/finan_text_primary" />
            </RadioGroup>

            <!-- Action buttons for existing category -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/category_view_transactions"
                    style="@style/Finan.Button.Nav"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="@string/category_view_transactions"
                    android:textColor="@color/finan_primary"
                    android:visibility="gone" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/category_delete"
                    style="@style/Finan.Button.Nav"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="@string/hc_dialog_category_editor_hapus"
                    android:textColor="@color/finan_error"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Default Switch Row -->
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/category_default_switch"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_control_surface"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/category_default_label"
                android:textColor="@color/finan_text_primary"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/category_default_hint"
                android:textColor="@color/finan_text_secondary"
                android:textSize="12sp" />

            <!-- Action Buttons (Save/Cancel) -->
            <com.dwlhm.finan.ui.common.DialogActionsView
                android:id="@+id/category_editor_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:primaryText="@string/category_save" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
