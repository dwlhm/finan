<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="20dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <!-- ── Title (edit mode only) ─────────────────────────────── -->
    <TextView
        android:id="@+id/transaction_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        android:text="@string/transaction_edit_title"
        android:textAppearance="@style/Finan.Text.Title"
        android:visibility="gone" />

    <!-- ── Detail panel ───────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/transaction_detail_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <!-- Hero row: icon | category + type | amount -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Category icon / emoji circle -->
            <FrameLayout
                android:id="@+id/transaction_detail_icon_container"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="14dp">

                <ImageView
                    android:id="@+id/transaction_detail_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:padding="12dp"
                    android:src="@drawable/ic_summary_filter"
                    app:tint="@android:color/white" />

                <TextView
                    android:id="@+id/transaction_detail_icon_emoji"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textSize="24sp"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Category name + type -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/transaction_detail_category"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/finan_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/transaction_detail_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/finan_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Amount (colored by type) -->
            <TextView
                android:id="@+id/transaction_detail_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Info card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_control_surface"
            android:orientation="vertical">

            <!-- Dompet -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.4"
                    android:text="@string/transaction_wallet_label"
                    android:textColor="@color/finan_text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/transaction_detail_wallet"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.6"
                    android:gravity="end"
                    android:textColor="@color/finan_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:background="@color/finan_divider" />

            <!-- Tanggal -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.4"
                    android:text="@string/transaction_date_label"
                    android:textColor="@color/finan_text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/transaction_detail_date"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.6"
                    android:gravity="end"
                    android:textColor="@color/finan_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:background="@color/finan_divider" />

            <!-- Catatan -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.4"
                    android:text="@string/transaction_note_label"
                    android:textColor="@color/finan_text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/transaction_detail_note"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.6"
                    android:gravity="end"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <!-- ── Edit panel ────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/transaction_edit_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <com.dwlhm.finan.ui.common.LabeledEditTextView
            android:id="@+id/transaction_edit_amount_field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            app:fieldHint="@string/capture_amount_placeholder"
            app:labelText="@string/transaction_amount_label" />

        <TextView
            style="@style/Finan.Text.SectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/transaction_type_label" />

        <RadioGroup
            android:id="@+id/transaction_edit_type_group"
            style="@style/Finan.Control.RadioGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/transaction_edit_type_expense"
                style="@style/Finan.Control.RadioButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="@color/radio_expense_tint"
                android:text="@string/capture_type_expense" />

            <RadioButton
                android:id="@+id/transaction_edit_type_income"
                style="@style/Finan.Control.RadioButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="@color/radio_income_tint"
                android:text="@string/capture_type_income" />
        </RadioGroup>

        <TextView
            style="@style/Finan.Text.SectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/transaction_wallet_label" />

        <Spinner
            android:id="@+id/transaction_edit_wallet_spinner"
            style="@style/Finan.Control.Surface"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <TextView
            style="@style/Finan.Text.SectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/transaction_category_label" />

        <Button
            android:id="@+id/transaction_edit_category_button"
            style="@style/Finan.Button.Select"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/transaction_category_pick" />

        <include
            layout="@layout/include_transaction_occurred_at"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp" />

        <TextView
            style="@style/Finan.Text.SectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/transaction_note_label" />

        <EditText
            android:id="@+id/transaction_edit_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_control_surface"
            android:hint="@string/capture_note_hint"
            android:importantForAutofill="no"
            android:inputType="textCapSentences|textMultiLine"
            android:minHeight="72dp"
            android:padding="12dp"
            android:textColor="@color/finan_text_primary"
            android:textColorHint="@color/finan_text_hint" />

    </LinearLayout>

    <!-- ── Shared action buttons ─────────────────────────────── -->
    <!-- Detail mode: primary=Edit, secondary=Hapus (danger outline) -->
    <!-- Edit mode:   primary=Simpan, secondary=Batal (ghost)       -->
    <LinearLayout
        android:id="@+id/transaction_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical">

        <Button
            android:id="@+id/transaction_action_primary"
            style="@style/Finan.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/transaction_edit_action" />

        <Button
            android:id="@+id/transaction_action_secondary"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_button_danger"
            android:minWidth="0dp"
            android:text="@string/transaction_delete_action"
            android:textAllCaps="false"
            android:textColor="@color/finan_error"
            android:textSize="15sp" />

    </LinearLayout>

</LinearLayout>
