<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottom_nav"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_nav"
    android:baselineAligned="false"
    android:elevation="4dp"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="6dp"
    android:paddingEnd="8dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/nav_capture"
        style="@style/Finan.BottomNavItem"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_weight="1"
        android:text="@string/nav_capture"
        android:drawableTint="@color/bottom_nav_icon"
        android:drawableTop="@drawable/ic_nav_capture" />

    <TextView
        android:id="@+id/nav_dashboard"
        style="@style/Finan.BottomNavItem"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_weight="1"
        android:text="Buku Kas"
        android:drawableTint="@color/bottom_nav_icon"
        android:drawableTop="@drawable/ic_nav_history" />

    <TextView
        android:id="@+id/nav_settings"
        style="@style/Finan.BottomNavItem"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_weight="1"
        android:text="@string/nav_settings"
        android:drawableTint="@color/bottom_nav_icon"
        android:drawableTop="@drawable/ic_nav_settings" />
</LinearLayout>
