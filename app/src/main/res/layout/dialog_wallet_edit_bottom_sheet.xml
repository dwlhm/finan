<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <!-- Bottom Sheet Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Title -->
            <TextView
                android:id="@+id/wallet_editor_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/wallet_edit_dialog_title"
                android:textAppearance="@style/Finan.Text.Title"
                android:textColor="@color/finan_text_primary" />

            <!-- Icon & Name Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Interactive Emoji Icon Avatar Container -->
                <FrameLayout
                    android:id="@+id/wallet_icon_container"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_wallet_icon_avatar"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">

                    <TextView
                        android:id="@+id/wallet_icon_preview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="👛"
                        android:textSize="32sp" />

                    <!-- Edit Badge -->
                    <TextView
                        android:id="@+id/wallet_icon_edit_badge"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="bottom|end"
                        android:layout_marginEnd="2dp"
                        android:layout_marginBottom="2dp"
                        android:background="@drawable/bg_chip_selected"
                        android:gravity="center"
                        android:text="✏️"
                        android:textSize="10sp" />
                </FrameLayout>

                <!-- Wallet Name Field -->
                <com.dwlhm.finan.ui.common.LabeledEditTextView
                    android:id="@+id/wallet_name_field"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:inputType="textCapWords"
                    app:fieldHint="@string/wallet_name_example"
                    app:labelText="@string/wallet_name_hint" />

                <!-- Legacy/Hidden Icon Input Field for code backing -->
                <com.dwlhm.finan.ui.common.LabeledEditTextView
                    android:id="@+id/wallet_icon_field"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Default Wallet CheckBox -->
            <CheckBox
                android:id="@+id/wallet_default_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:buttonTint="@color/checkbox_default_tint"
                android:minHeight="40dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="@string/wallet_make_default"
                android:textColor="@color/finan_text_primary" />

            <!-- Action Buttons (Save/Cancel) -->
            <com.dwlhm.finan.ui.common.DialogActionsView
                android:id="@+id/wallet_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:primaryText="@string/wallet_save_name" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
