<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UseCompoundDrawables,Overdraw,DisableBaselineAlignment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:colorBackground"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsing_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:titleEnabled="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                app:layout_collapseMode="parallax"
                app:layout_collapseParallaxMultiplier="0.7">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/month_picker_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1dp">

                    <TextView
                        android:id="@+id/month_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="8dp"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="8dp"
                        android:text="@string/hc_fragment_monthly_dashboard_juli_2026"
                        android:textColor="@color/finan_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:drawableEndCompat="@drawable/ic_expand_more"
                        app:drawableTint="?attr/colorOnSurface" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Hero Card: Donut Chart -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="16dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="20dp"
                        android:paddingBottom="20dp">

                        <com.dwlhm.finan.ui.components.DonutChartView
                            android:id="@+id/donut_chart"
                            android:layout_width="120dp"
                            android:layout_height="120dp"
                            android:layout_marginStart="16dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            android:layout_marginEnd="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <!-- Saldo Bersih -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/hc_fragment_monthly_dashboard_saldo_bersih"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:textSize="12sp" />

                                <ImageView
                                    android:id="@+id/monthly_hero_advice_btn"
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_marginStart="6dp"
                                    android:contentDescription="@string/app_name"
                                    android:src="@drawable/ic_info"
                                    app:tint="?attr/colorOnSurfaceVariant" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/monthly_hero_net_balance"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/finan_primary"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginTop="12dp"
                                android:layout_marginBottom="12dp"
                                android:background="?attr/colorOutlineVariant" />

                            <!-- Pemasukan -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <View
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:background="@drawable/bg_circle_green" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:layout_weight="1"
                                    android:text="@string/hc_fragment_monthly_dashboard_pemasukan"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:textSize="11sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/monthly_hero_income"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="16dp"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/finan_primary"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <!-- Pengeluaran -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <View
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:background="@drawable/bg_circle_red" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:layout_weight="1"
                                    android:text="@string/hc_fragment_monthly_dashboard_pengeluaran"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:textSize="11sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/monthly_hero_expense"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="16dp"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/finan_expense"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Mini Header for Collapsed State -->
            <FrameLayout
                android:id="@+id/collapsed_toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="?android:colorBackground"
                android:alpha="0"
                app:layout_collapseMode="pin">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="2dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hc_fragment_monthly_dashboard_saldo_bersih"
                            android:textSize="11sp"
                            android:textColor="@color/finan_text_secondary"
                            android:textAllCaps="true"
                            android:letterSpacing="0.05" />
                        <ImageView android:contentDescription="@string/app_name"
                            android:id="@+id/collapsed_advice_btn"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="6dp"
                            android:src="@drawable/ic_info"
                            app:tint="@color/finan_text_secondary"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/collapsed_balance_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/finan_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.appbar.CollapsingToolbarLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            android:background="?android:colorBackground">

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/monthly_tabs"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_tab_container"
                app:tabIndicator="@drawable/bg_tab_indicator"
                app:tabIndicatorAnimationMode="elastic"
                app:tabIndicatorGravity="stretch"
                app:tabIndicatorFullWidth="true"
                app:tabMode="fixed"
                app:tabGravity="fill"
                app:tabMaxWidth="0dp"
                app:tabPaddingStart="0dp"
                app:tabPaddingEnd="0dp"
                app:tabRippleColor="@null"
                app:tabSelectedTextColor="@android:color/white"
                app:tabTextAppearance="@style/Finan.TabTextAppearance"
                app:tabTextColor="?attr/colorOnSurfaceVariant">

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hc_fragment_monthly_dashboard_transaksi" />

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hc_fragment_monthly_dashboard_ringkasan" />
            </com.google.android.material.tabs.TabLayout>
        </FrameLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/finan_divider" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Content (RecyclerView) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/monthly_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="80dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <!-- Empty State for Transactions -->
    <LinearLayout
        android:id="@+id/monthly_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_nav_history"
            app:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/monthly_empty_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/history_empty"
            android:textColor="?attr/colorOnSurface"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/monthly_empty_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/history_empty_hint"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp" />
    </LinearLayout>
    
    <!-- Summary Tab Content (Hidden by Default) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/monthly_summary_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:visibility="gone"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="80dp">

            <!-- Weekly Chart (Aktivitas Mingguan) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/monthly_weekly_chart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:visibility="gone"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/monthly_weekly_chart_title"
                            style="@style/Finan.Text.SectionLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/hc_fragment_monthly_dashboard_aktivitas_harian" />

                        <FrameLayout
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_toggle_track"
                            android:padding="2dp">

                            <com.google.android.material.button.MaterialButtonToggleGroup
                                android:id="@+id/monthly_weekly_toggle_group"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                app:selectionRequired="true"
                                app:singleSelection="true">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/monthly_chart_toggle_income"
                                    style="?attr/materialButtonOutlinedStyle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:insetTop="0dp"
                                    android:insetBottom="0dp"
                                    android:paddingStart="12dp"
                                    android:paddingEnd="12dp"
                                    android:text="@string/hc_fragment_monthly_dashboard_pemasukan"
                                    android:textColor="@color/finan_toggle_text_selector"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    app:backgroundTint="@color/finan_toggle_bg_selector"
                                    app:cornerRadius="16dp"
                                    app:strokeWidth="0dp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/monthly_chart_toggle_expense"
                                    style="?attr/materialButtonOutlinedStyle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:insetTop="0dp"
                                    android:insetBottom="0dp"
                                    android:paddingStart="12dp"
                                    android:paddingEnd="12dp"
                                    android:text="@string/hc_fragment_monthly_dashboard_pengeluaran"
                                    android:textColor="@color/finan_toggle_text_selector"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    app:backgroundTint="@color/finan_toggle_bg_selector"
                                    app:cornerRadius="16dp"
                                    app:strokeWidth="0dp" />
                            </com.google.android.material.button.MaterialButtonToggleGroup>
                        </FrameLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/monthly_chart_legend"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:orientation="horizontal" />

                    <LinearLayout
                        android:id="@+id/monthly_chart_weeks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Category Breakdown Chart -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/monthly_category_chart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:visibility="gone"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Finan.Text.SectionLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/hc_fragment_monthly_dashboard_total_per_kategori" />

                        <FrameLayout
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_toggle_track"
                            android:padding="2dp">

                            <com.google.android.material.button.MaterialButtonToggleGroup
                                android:id="@+id/monthly_cat_toggle_group"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                app:selectionRequired="true"
                                app:singleSelection="true">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/monthly_cat_chart_toggle_income"
                                    style="?attr/materialButtonOutlinedStyle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:insetTop="0dp"
                                    android:insetBottom="0dp"
                                    android:paddingStart="12dp"
                                    android:paddingEnd="12dp"
                                    android:text="@string/hc_fragment_monthly_dashboard_pemasukan"
                                    android:textColor="@color/finan_toggle_text_selector"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    app:backgroundTint="@color/finan_toggle_bg_selector"
                                    app:cornerRadius="16dp"
                                    app:strokeWidth="0dp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/monthly_cat_chart_toggle_expense"
                                    style="?attr/materialButtonOutlinedStyle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:insetTop="0dp"
                                    android:insetBottom="0dp"
                                    android:paddingStart="12dp"
                                    android:paddingEnd="12dp"
                                    android:text="@string/hc_fragment_monthly_dashboard_pengeluaran"
                                    android:textColor="@color/finan_toggle_text_selector"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    app:backgroundTint="@color/finan_toggle_bg_selector"
                                    app:cornerRadius="16dp"
                                    app:strokeWidth="0dp" />
                            </com.google.android.material.button.MaterialButtonToggleGroup>
                        </FrameLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/monthly_category_bars"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
