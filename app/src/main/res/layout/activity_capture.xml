<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/finan_background"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Toggle -->
    <!-- Main Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Capture Flow Sentence -->
        <com.dwlhm.finan.ui.components.FlowLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:layout_marginEnd="4dp">

                <TextView
                    android:id="@+id/capture_sentence_prefix"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_madlibs_field"
                    android:paddingVertical="2dp"
                    android:paddingHorizontal="6dp"
                    android:text="Keluar "
                    android:textColor="@color/finan_primary"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:text="Rp"
                    android:textColor="@color/finan_primary"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/capture_amount"
                    style="@style/Finan.EditText.Transparent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="48dp"
                    android:maxWidth="200dp"
                    android:hint="0"
                    android:focusable="false"
                    android:cursorVisible="false"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="12sp"
                    android:autoSizeMaxTextSize="32sp"
                    android:padding="0dp"
                    android:textColor="@color/finan_text_primary"
                    android:textSize="32sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/capture_sentence_for"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:layout_marginEnd="4dp"
                android:text=" untuk "
                android:textColor="@color/finan_text_secondary"
                android:textSize="32sp" />

            <TextView
                android:id="@+id/capture_category_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_madlibs_field"
                android:paddingVertical="2dp"
                android:paddingHorizontal="6dp"
                android:text="#Category"
                android:textColor="@color/finan_primary"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/capture_sentence_from"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:layout_marginEnd="4dp"
                android:text=" dari "
                android:textColor="@color/finan_text_secondary"
                android:textSize="32sp" />

            <TextView
                android:id="@+id/capture_wallet_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_madlibs_field"
                android:paddingVertical="2dp"
                android:paddingHorizontal="6dp"
                android:drawableStart="@drawable/ic_wallet"
                android:drawablePadding="4dp"
                android:drawableTint="@color/finan_primary"
                android:text="Wallet"
                android:textColor="@color/finan_primary"
                android:textSize="32sp"
                android:textStyle="bold" />
        </com.dwlhm.finan.ui.components.FlowLayout>

        <!-- Date & Note Chips -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/capture_date_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="\@Now"
                android:textColor="@color/finan_text_secondary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/capture_note"
                style="@style/Finan.EditText.Transparent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip"
                android:hint="add note..."
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:textColorHint="@color/finan_text_hint"
                android:textSize="14sp"
                android:textStyle="italic" />
        </LinearLayout>

        <TextView
            android:id="@+id/capture_validation_banner"
            style="@style/Finan.Text.FieldError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_panel_emphasis_error"
            android:drawableStart="@drawable/ic_error"
            android:drawablePadding="8dp"
            android:padding="8dp"
            android:gravity="center_vertical"
            android:text="@string/capture_validation_hint"
            android:visibility="gone" />
    </LinearLayout>
    


    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.dwlhm.finan.ui.components.CalculatorStripView
        android:id="@+id/capture_calculator_strip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <com.dwlhm.finan.ui.components.FinancialKeypadView
        android:id="@+id/capture_financial_keypad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/capture_save"
        style="@style/Finan.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_margin="16dp"
        android:background="@drawable/bg_button_pill"
        android:textColor="@color/btn_text_pill"
        android:paddingHorizontal="24dp"
        android:text="Record Transaction"
        android:textSize="18sp"
        android:textStyle="bold" />

</LinearLayout>
