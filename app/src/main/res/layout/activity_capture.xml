<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/finan_background"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Toggle -->
    <!-- Main Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Capture Flow Sentence -->
        <com.dwlhm.finan.ui.components.FlowLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:layout_marginEnd="4dp">

                <TextView
                    android:id="@+id/capture_sentence_prefix"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_madlibs_field"
                    android:paddingVertical="2dp"
                    android:paddingHorizontal="6dp"
                    android:text="Keluar "
                    android:textColor="@color/finan_primary"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:text="Rp"
                    android:textColor="@color/finan_primary"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/capture_amount"
                    style="@style/Finan.EditText.Transparent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="48dp"
                    android:maxWidth="200dp"
                    android:hint="0"
                    android:focusable="false"
                    android:cursorVisible="false"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="12sp"
                    android:autoSizeMaxTextSize="32sp"
                    android:padding="0dp"
                    android:textColor="@color/finan_text_primary"
                    android:textSize="32sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/capture_sentence_for"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:layout_marginEnd="4dp"
                android:text=" untuk "
                android:textColor="@color/finan_text_secondary"
                android:textSize="32sp" />

            <TextView
                android:id="@+id/capture_category_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_madlibs_field"
                android:paddingVertical="2dp"
                android:paddingHorizontal="6dp"
                android:text="#Category"
                android:textColor="@color/finan_primary"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/capture_sentence_from"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:layout_marginEnd="4dp"
                android:text=" dari "
                android:textColor="@color/finan_text_secondary"
                android:textSize="32sp" />

            <TextView
                android:id="@+id/capture_wallet_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_madlibs_field"
                android:paddingVertical="2dp"
                android:paddingHorizontal="6dp"
                android:drawableStart="@drawable/ic_wallet"
                android:drawablePadding="4dp"
                android:drawableTint="@color/finan_primary"
                android:text="Wallet"
                android:textColor="@color/finan_primary"
                android:textSize="32sp"
                android:textStyle="bold" />
        </com.dwlhm.finan.ui.components.FlowLayout>

        <!-- Date & Note Chips -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/capture_date_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="\@Now"
                android:textColor="@color/finan_text_secondary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/capture_note"
                style="@style/Finan.EditText.Transparent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip"
                android:hint="add note..."
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:textColorHint="@color/finan_text_hint"
                android:textSize="14sp"
                android:textStyle="italic" />
        </LinearLayout>

        <TextView
            android:id="@+id/capture_validation_banner"
            style="@style/Finan.Text.FieldError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_panel_emphasis_error"
            android:drawableStart="@drawable/ic_error"
            android:drawablePadding="8dp"
            android:padding="8dp"
            android:gravity="center_vertical"
            android:text="@string/capture_validation_hint"
            android:visibility="gone" />
    </LinearLayout>
    


    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.dwlhm.finan.ui.components.CalculatorStripView
        android:id="@+id/capture_calculator_strip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <com.dwlhm.finan.ui.components.FinancialKeypadView
        android:id="@+id/capture_financial_keypad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp" />

    <FrameLayout
        android:id="@+id/capture_save_container"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginHorizontal="8dp"
        android:layout_marginBottom="16dp"
        android:clickable="true"
        android:focusable="true">

        <!-- State normal: area tombol kustom -->
        <FrameLayout
            android:id="@+id/capture_save_button_area"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_button_pill_ripple"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/capture_save_label"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="Simpan Pengeluaran"
                android:textColor="@color/btn_text_pill"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <View
                android:id="@+id/capture_hold_progress"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_gravity="bottom"
                android:background="#4DFFFFFF"
                android:scaleX="0"
                android:transformPivotX="0dp" />
        </FrameLayout>

        <!-- State undo -->
        <LinearLayout
            android:id="@+id/capture_undo_row"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_button_pill"
            android:backgroundTint="#E8F5E9"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="✓ Tersimpan"
                android:textColor="@color/finan_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Batalkan ditaruh di dalam chip dengan warna merah hangat sebagai aksi pembatalan -->
            <FrameLayout
                android:id="@+id/capture_undo_action"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_undo_action_chip"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="12dp">

                <TextView
                    android:id="@+id/capture_undo_action_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Batalkan"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>

    </FrameLayout>

</LinearLayout>

