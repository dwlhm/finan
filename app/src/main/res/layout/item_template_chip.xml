<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="6dp"
    android:background="@drawable/bg_chip"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="8dp"
    android:paddingVertical="4dp">

    <TextView
        android:id="@+id/chip_template_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:text="⚡"
        android:textColor="@color/finan_text_primary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/chip_template_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:singleLine="true"
        android:text="Kopi Pagi"
        android:textColor="@color/finan_text_primary"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/chip_template_details"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="3dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:singleLine="true"
        android:text="• Rp 18.000"
        android:textColor="@color/finan_text_secondary"
        android:textSize="10sp" />
</LinearLayout>
