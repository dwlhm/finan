<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <TextView
        android:id="@+id/manage_template_icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_chip"
        android:gravity="center"
        android:text="⚡"
        android:textSize="18sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/manage_template_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kopi Pagi"
            android:textColor="@color/finan_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/manage_template_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="EXPENSE • Rp18.000"
            android:textColor="@color/finan_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/manage_template_btn_edit"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Edit"
        android:src="@drawable/ic_edit"
        app:tint="@color/finan_text_secondary" />

    <ImageButton
        android:id="@+id/manage_template_btn_delete"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Hapus"
        android:src="@drawable/ic_delete"
        app:tint="@color/finan_text_secondary" />

</LinearLayout>
