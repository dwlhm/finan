<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/advice_dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nasihat Keuangan"
        android:textColor="@color/finan_text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/advice_dialog_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/finan_text_secondary"
        android:textSize="15sp"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Data Pendukung"
        android:textColor="@color/finan_text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Pemasukan"
            android:textColor="@color/finan_text_secondary"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/advice_dialog_income"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/finan_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Pengeluaran"
            android:textColor="@color/finan_text_secondary"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/advice_dialog_expense"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/finan_expense"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Rasio Pengeluaran"
            android:textColor="@color/finan_text_secondary"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/advice_dialog_ratio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/finan_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <Button
        android:id="@+id/advice_dialog_close"
        style="@style/Widget.AppCompat.Button.Borderless"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Tutup"
        android:textColor="@color/finan_primary" />
</LinearLayout>
