<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/finan_cancel_pressed">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/finan_cancel_pressed" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/finan_coral_cancel" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/finan_translucent_pill_bg" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/finan_cancel_stroke" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
