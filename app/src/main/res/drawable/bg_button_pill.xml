<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Disabled: abu terang, teks tidak menarik perhatian -->
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#DDE3E8" />
            <corners android:radius="20dp" />
        </shape>
    </item>

    <!-- Pressed: warna gelap, memberikan efek "ditekan" -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/finan_primary_dark" />
            <corners android:radius="20dp" />
        </shape>
    </item>

    <!-- Default enabled: gradient teal ke hijau halus -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#2D6A6A"
                android:endColor="#3A7E68"
                android:angle="135"
                android:type="linear" />
            <corners android:radius="20dp" />
        </shape>
    </item>

</selector>
