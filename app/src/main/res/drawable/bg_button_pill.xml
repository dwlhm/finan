<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Disabled: abu terang, teks tidak menarik perhatian -->
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/finan_btn_disabled_bg" />
            <corners android:radius="20dp" />
        </shape>
    </item>

    <!-- Pressed: warna gelap, memberikan efek "ditekan" -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/finan_primary_dark" />
            <corners android:radius="20dp" />
        </shape>
    </item>

    <!-- Default enabled: gradient teal ke hijau halus -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/finan_primary" />
            <corners android:radius="20dp" />
        </shape>
    </item>

</selector>
