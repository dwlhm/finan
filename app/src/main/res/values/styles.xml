<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Finan.Text.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/finan_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Finan.Text.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/finan_text_primary</item>
    </style>

    <style name="Finan.Text.Amount" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">32sp</item>
        <item name="android:textColor">@color/finan_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Finan.Text.SectionLabel" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/finan_text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Finan.Text.RequiredMarker" parent="@android:style/TextAppearance.Material.Body2">
        <item name="android:importantForAccessibility">no</item>
        <item name="android:text">@string/label_required_marker</item>
        <item name="android:textColor">@color/finan_error</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Finan.Text.FieldError" parent="@android:style/TextAppearance.Material.Caption">
        <item name="android:textColor">@color/finan_error</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Finan.Text.CollapsibleLabel" parent="@android:style/TextAppearance.Material.Body2">
        <item name="android:textColor">@color/finan_text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Finan.Panel.Emphasis" parent="@android:style/Widget">
        <item name="android:background">@drawable/bg_panel_emphasis</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingBottom">16dp</item>
    </style>

    <style name="Finan.Panel.Section" parent="@android:style/Widget">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">14dp</item>
    </style>

    <style name="Finan.Panel.CollapsibleContent" parent="@android:style/Widget">
        <item name="android:background">@drawable/bg_control_surface</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">12dp</item>
    </style>

    <style name="Finan.Control.Surface" parent="@android:style/Widget">
        <item name="android:background">@drawable/bg_control_surface</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
    </style>

    <style name="Finan.Control.OccurredAtValue" parent="@android:style/Widget">
        <item name="android:background">@drawable/bg_control_surface</item>
        <item name="android:clickable">true</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:drawableEnd">@drawable/ic_occurred_at_chevron</item>
        <item name="android:ellipsize">end</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?android:attr/selectableItemBackground</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:maxLines">1</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textColor">@color/finan_text_primary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Finan.Control.RadioGroup" parent="@android:style/Widget">
        <item name="android:background">@drawable/bg_control_surface</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
    </style>

    <style name="Finan.Control.RadioButton" parent="@android:style/Widget.Material.CompoundButton.RadioButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">@color/finan_text_primary</item>
    </style>

    <style name="Finan.Control.CollapsibleToggle" parent="@android:style/Widget">
        <item name="android:background">@drawable/bg_control_surface</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?android:attr/selectableItemBackground</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

    <style name="Finan.Icon.ControlIndicator" parent="@android:style/Widget">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:tint">@color/finan_primary</item>
    </style>

    <style name="Finan.EditText.Transparent" parent="@android:style/Widget.Material.EditText">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:importantForAutofill">no</item>
    </style>

    <style name="Finan.Button.Primary" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/finan_btn_pill_text</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Finan.Button.Nav" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:textColor">@color/finan_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">40dp</item>
    </style>

    <style name="Finan.Button.Select" parent="Finan.Button.Nav">
        <item name="android:background">@drawable/bg_control_surface</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

    <style name="Finan.CalculatorOperatorButton" parent="@android:style/Widget.Material.TextView">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:background">@drawable/bg_calculator_operator</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/finan_key_text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Finan.BottomNav.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/finan_bottom_nav_active_bg</item>
    </style>

    <style name="Finan.BottomNav.Text" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Finan.TabTextAppearance" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Finan.Text.WalletHeroLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/finan_summary_on_hero_muted</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Finan.Text.WalletHeroAmount" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/finan_summary_on_hero</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Finan.Text.WalletHeroSecondary" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/finan_summary_on_hero_muted</item>
    </style>

    <style name="Finan.Text.WalletHeroButton" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">#1F4E4E</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Finan.Text.WalletName" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/finan_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Finan.Text.WalletBalance" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/finan_text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Finan.Text.WalletCurrency" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/finan_text_secondary</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
