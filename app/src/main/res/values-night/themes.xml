<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Finan" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/finan_primary</item>
        <item name="android:colorPrimaryDark">@color/finan_primary_dark</item>
        <item name="android:colorAccent">@color/finan_accent</item>
        <item name="android:windowBackground">@color/finan_background</item>
        <item name="android:textColorPrimary">@color/finan_text_primary</item>
        <item name="android:textColorSecondary">@color/finan_text_secondary</item>
    </style>

    <style name="Finan.BottomSheetDialog" parent="@android:style/Theme.Material.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>
</resources>
