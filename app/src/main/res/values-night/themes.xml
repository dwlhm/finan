<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Finan" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/finan_primary</item>
        <item name="colorOnPrimary">#003737</item>
        <item name="colorPrimaryContainer">#1F4E4E</item>
        <item name="colorOnPrimaryContainer">#E6F0EF</item>
        <item name="colorSurface">@color/finan_surface</item>
        <item name="colorOnSurface">@color/finan_text_primary</item>
        <item name="colorSurfaceContainer">#161D22</item>
        <item name="colorSurfaceContainerHigh">#242F37</item>
        <item name="colorSurfaceContainerLow">#1A2228</item>
        <item name="colorOutline">#5C6B73</item>
        <item name="colorOutlineVariant">@color/finan_divider</item>
        <item name="colorError">@color/finan_error</item>
        <item name="colorErrorContainer">@color/finan_error_bg</item>
        <item name="colorOnSurfaceVariant">@color/finan_text_secondary</item>
        <item name="colorPrimaryDark">@color/finan_primary_dark</item>
        <item name="colorAccent">@color/finan_accent</item>
        <item name="android:colorPrimary">@color/finan_primary</item>
        <item name="android:colorPrimaryDark">@color/finan_primary_dark</item>
        <item name="android:colorAccent">@color/finan_accent</item>
        <item name="android:windowBackground">@color/finan_background</item>
        <item name="android:textColorPrimary">@color/finan_text_primary</item>
        <item name="android:textColorSecondary">@color/finan_text_secondary</item>
        <item name="android:statusBarColor">@color/finan_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="bottomSheetDialogTheme">@style/Finan.BottomSheetDialog</item>
    </style>

    <style name="Finan.ShapeAppearance.BottomSheet" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
    </style>

    <style name="Finan.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="shapeAppearance">@style/Finan.ShapeAppearance.BottomSheet</item>
        <item name="backgroundTint">@color/finan_surface</item>
    </style>

    <style name="Finan.BottomSheetDialog" parent="Theme.Material3.DayNight.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Finan.BottomSheet</item>
    </style>
</resources>
